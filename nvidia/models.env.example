# NVIDIA development model inventory; prepared 2026-11-02.
# Scene planning and the editing agent consume the validated task routes when enabled.
# Copy only the settings needed locally; credentials are intentionally blank in this example.
# The development .env has created credentials; endpoint access and live checks remain pending.
NVIDIA_PROVIDER_ENABLED=false
NVIDIA_CREDENTIAL_STATUS=not_configured
NVIDIA_KEY_EXPIRATION_POLICY=never
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_EMBEDDING_ENDPOINT=https://integrate.api.nvidia.com/v1/embeddings
NVIDIA_GRPC_TARGET=grpc.nvcf.nvidia.com:443
NVIDIA_REQUEST_TIMEOUT_SECONDS=30
NVIDIA_MAX_ATTEMPTS=6

# Full previous recommendation order; mixed-role lists are inventories, not interchangeable fallbacks.
NVIDIA_USECASE_AGENT_MODELS=nvidia/nemotron-3.5-super-vl-120b-a12b,mistralai/mistral-large-4-1t-a52b,nvidia/nemotron-3-ultra-550b-a55b,deepseek-ai/deepseek-v4.1-flash,google/gemma-4-31b-it

# Full previous recommendation order; mixed-role lists are inventories, not interchangeable fallbacks.
NVIDIA_USECASE_WRITING_MODELS=mistralai/mistral-large-4-1t-a52b,google/gemma-4-31b-it,nvidia/nemotron-3.5-super-vl-120b-a12b,deepseek-ai/deepseek-v4.1-flash,nvidia/nemotron-3.5-lightning-30b-a3b

# Full previous recommendation order; mixed-role lists are inventories, not interchangeable fallbacks.
NVIDIA_USECASE_MEDIA_UNDERSTANDING_MODELS=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning,nvidia/nemotron-3.5-super-vl-120b-a12b,google/gemma-4-31b-it,mistralai/mistral-large-4-1t-a52b,nvidia/cosmos3-nano-reasoner

# Full previous recommendation order; mixed-role lists are inventories, not interchangeable fallbacks.
NVIDIA_USECASE_TRANSLATION_MODELS=nvidia/riva-translate-4b-instruct-v2,google/gemma-4-31b-it,mistralai/mistral-large-4-1t-a52b,deepseek-ai/deepseek-v4.1-flash,nvidia/nemotron-3-ultra-550b-a55b

# Full previous recommendation order; mixed-role lists are inventories, not interchangeable fallbacks.
NVIDIA_USECASE_RETRIEVAL_MODELS=nvidia/nemotron-3.5-embed-1b,nvidia/nemotron-3.5-embed-8b,nvidia/nemotron-3.5-rerank-8b,nvidia/nemotron-3-embed-1b,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Full previous recommendation order; mixed-role lists are inventories, not interchangeable fallbacks.
NVIDIA_USECASE_SPEECH_AUDIO_MEDIA_MODELS=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning,nvidia/magpie-tts-zeroshot,nvidia/nemotron-voicechat,nvidia/bnr,nvidia/studiovoice,nvidia/cosmos3-nano,nvidia/cosmos-transfer2.5-2b,nvidia/active-speaker-detection,nvidia/body-pose

NVIDIA_ROUTE_AGENT_FAST_PRIMARY=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_ROUTE_AGENT_FAST_FALLBACKS=nvidia/nemotron-3-ultra-550b-a55b

NVIDIA_ROUTE_AGENT_COMPLEX_PRIMARY=nvidia/nemotron-3.5-super-vl-120b-a12b
