{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "baseUrl": ".",
    "paths": {
      "@vidsai/*": [
        "./shared/*"
      ]
    }
  },
  "include": [
    "resources/js/editor/**/*.ts",
    "resources/js/editor/**/*.tsx"
  ]
}
