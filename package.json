{
  "$schema": "https://json.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run motion:check-resources && vite build --configLoader native",
    "dev": "tsx watch server/start.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "start": "tsx server/start.ts",
    "dev:ui": "vite",
    "test": "node scripts/test-server.cjs",
    "local:start": "node scripts/node-local.cjs start",
    "local:stop": "node scripts/node-local.cjs stop",
    "local:status": "node scripts/node-local.cjs status",
    "test:browser": "node scripts/node-browser-check.cjs",
    "motion:setup": "node scripts/motion-setup.mjs",
    "motion:doctor": "node scripts/motion-doctor.mjs",
    "motion:tools": "node scripts/motion-tools.mjs",
    "motion:inventory": "node --import tsx scripts/motion-inventory.ts",
    "motion:check-models": "node --import tsx scripts/motion-check-models.ts",
    "motion:verify-render": "node scripts/motion-verify-render.mjs",
    "motion:test": "node scripts/motion-test.mjs",
    "motion:check-resources": "node --import tsx scripts/motion-check-resources.ts",
    "import:media": "node scripts/import-media.cjs",
    "test:fresh": "node scripts/test-server.cjs --fresh"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "csstype": "3.1.3",
    "playwright": "1.62.1",
    "typescript": "5.8.2",
    "vite": "^6.2.4"
  },
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@remotion/media": "4.0.541",
    "@remotion/player": "4.0.541",
    "@remotion/web-renderer": "4.0.541",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.8.0",
    "express": "^5.1.0",
    "mediabunny": "1.64.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "quickjs-emscripten-core": "0.32.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.541",
    "tsx": "^4.19.3",
    "zod": "4.6.7"
  },
  "name": "vidsai",
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "better-sqlite3@12.8.0": true,
    "esbuild@0.25.6": true
  }
}
